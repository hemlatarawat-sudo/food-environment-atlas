"""Food access analysis pipeline (ANLY 615, Milestone 3).

Connects to the PostgreSQL database, pulls the USDA Food Environment Atlas
tables straight into Pandas with ``pd.read_sql()``, cleans and merges them,
engineers features, and writes diagnostic and stakeholder charts.

Business question:
    Which 10 Texas counties have the most low-income, low-access residents
    relative to their grocery store count (best next-store opportunities)?

Run:
    export DATABASE_URL="postgresql+psycopg2://USER:PASSWORD@localhost:5432/DB"
    python food_access_pipeline.py

NOTE: Column names follow the public Food Environment Atlas codebook (see
variable_list.csv). If a name differs in your tables, edit COLUMNS only.
"""

import os
import re
from pathlib import Path

import matplotlib.pyplot as plt
import pandas as pd
import seaborn as sns
from sqlalchemy import create_engine, text

OUTPUT_DIR = Path("figures")
STATE = "TX"

SCHEMA = "atlas"

# Measures needed, as (table, column prefix). The newest available year
# (the two-digit suffix, e.g. groc20) is detected from the database.
MEASURES = [
    ("access", "laccess_pop"),
    ("access", "laccess_lowi"),
    ("access", "pct_laccess_pop"),
    ("stores", "groc"),
    ("assistance", "pct_snap"),
    ("socioeconomic", "povrate"),
    ("socioeconomic", "medhhinc"),
]

# Atlas files use -9999 (and similar) as "not available" codes.
SENTINELS = [-9999, -8888]


# ----------------------------------------------------------------------
# 1. Database connection and extraction
# ----------------------------------------------------------------------
def get_engine():
    """Build a SQLAlchemy engine; defaults to the team Docker database."""
    url = os.environ.get(
        "DATABASE_URL",
        "postgresql+psycopg2://atlas_user:atlas_password"
        "@localhost:5432/food_atlas")
    return create_engine(url)


def latest_column(engine, table, prefix):
    """Find the newest-year column, e.g. 'groc' -> 'groc20'."""
    query = text("SELECT column_name FROM information_schema.columns "
                 "WHERE table_schema = :s AND table_name = :t")
    cols = pd.read_sql(query, engine, params={"s": SCHEMA, "t": table})
    pattern = re.compile(rf"^{prefix}(\d{{2}})$")
    matches = [(int(m.group(1)), c) for c in cols["column_name"]
               if (m := pattern.match(c))]
    if not matches:
        raise SystemExit(f"No column like {prefix}## in {SCHEMA}.{table}")
    return max(matches)[1]


def load_tables(engine):
    """Query each table directly into a DataFrame (no manual CSV exports)."""
    wanted = {}
    for table, prefix in MEASURES:
        wanted.setdefault(table, []).append(
            latest_column(engine, table, prefix))
    tables = {}
    for table, cols in wanted.items():
        extra = ["fips", "state", "county"] if table == "access" else ["fips"]
        query = (f"SELECT {', '.join(extra + cols)} FROM {SCHEMA}.{table} "
                 "WHERE fips IS NOT NULL")
        tables[table] = pd.read_sql(query, engine)
        print(f"Loaded {table}: {tables[table].shape} -> {cols}")
    return tables


# ----------------------------------------------------------------------
# 2. Wrangling
# ----------------------------------------------------------------------
def clean_numeric(series):
    """Strip text noise (commas, %, $, footnote marks) and cast to float."""
    cleaned = (series.astype(str)
               .str.replace(r"[,$%*]", "", regex=True)
               .str.strip()
               .replace({"": None, "nan": None, "None": None, "NA": None}))
    return pd.to_numeric(cleaned, errors="coerce")


def standardize_keys(df):
    """Make FIPS a zero-padded 5-character string so joins line up."""
    df = df.copy()
    df["fips"] = df["fips"].astype(str).str.strip().str.zfill(5)
    return df


def wrangle(tables):
    """Clean every table, diagnose missing values and duplicates, merge."""
    cleaned = {}
    for name, df in tables.items():
        df = standardize_keys(df)

        # Duplicate diagnosis: one row per county is expected.
        dupes = df.duplicated(subset="fips").sum()
        print(f"{name}: {dupes} duplicate county rows")
        df = df.drop_duplicates(subset="fips", keep="first")

        # Cast every non-key column to numeric.
        for col in df.columns.difference(["fips", "state", "county"]):
            df[col] = clean_numeric(df[col])
        # Replace "not available" codes with real missing values.
        df = df.replace(SENTINELS, float("nan"))
        # Drop the year suffix so downstream code is year-agnostic.
        df.columns = [re.sub(r"\d{2}$", "", c) for c in df.columns]
        cleaned[name] = df

    # Merge on county FIPS; the access table is the base (has names).
    merged = cleaned["access"]
    for name in ("stores", "assistance", "socioeconomic"):
        merged = pd.merge(merged, cleaned[name], on="fips", how="left")

    # Missing-value diagnosis.
    missing = merged.isna().mean().sort_values(ascending=False)
    print("\nShare of missing values per column:\n", missing.round(3))

    # Remediation strategy (documented):
    #  - Rows missing the core outcome fields are dropped: imputing them
    #    would invent the very quantity being ranked.
    #  - Remaining socioeconomic gaps are filled with the median; this
    #    slightly shrinks variance, noted as a limitation.
    core = ["laccess_lowi", "groc", "laccess_pop"]
    merged = merged.dropna(subset=core)
    for col in ["pct_snap", "povrate", "medhhinc"]:
        merged[col] = merged[col].fillna(merged[col].median())
    return merged


# ----------------------------------------------------------------------
# 3. Feature engineering
# ----------------------------------------------------------------------
def engineer_features(df):
    """Add population, store density, opportunity score and tier."""
    df = df.copy()
    # Population is back-solved from the low-access count and its share.
    df["population"] = (df["laccess_pop"]
                        / (df["pct_laccess_pop"] / 100)).round()

    # Grocery stores per 10,000 residents.
    df["groc_per_10k"] = df["groc"] / df["population"] * 10_000

    # Low-income, low-access residents per grocery store (+1 avoids /0).
    df["lowi_per_store"] = df["laccess_lowi"] / (df["groc"] + 1)

    # Row-wise tier label using a lambda.
    q75 = df["lowi_per_store"].quantile(0.75)
    q50 = df["lowi_per_store"].median()
    df["need_tier"] = df["lowi_per_store"].apply(
        lambda x: "High" if x >= q75 else "Medium" if x >= q50 else "Low")
    return df


# ----------------------------------------------------------------------
# 4. Visualization
# ----------------------------------------------------------------------
def diagnostic_plots(df):
    """Histogram and boxplot to check distributions and outliers."""
    fig, axes = plt.subplots(1, 2, figsize=(12, 4))
    sns.histplot(df["lowi_per_store"], bins=30, ax=axes[0])
    axes[0].set_title("Low-income, low-access residents per store")
    axes[0].set_xlabel("Residents per store")
    sns.boxplot(x=df["groc_per_10k"], ax=axes[1])
    axes[1].set_title("Grocery stores per 10,000 residents")
    axes[1].set_xlabel("Stores per 10,000")
    fig.tight_layout()
    fig.savefig(OUTPUT_DIR / "diagnostic_distributions.png", dpi=200)
    plt.close(fig)


def stakeholder_charts(df):
    """Business-ready charts: top-10 bar chart and a scatter plot."""
    top10 = df.nlargest(10, "lowi_per_store").sort_values("lowi_per_store")
    fig, ax = plt.subplots(figsize=(9, 5))
    ax.barh(top10["county"], top10["lowi_per_store"], color="#1f5f8b")
    ax.set_title(f"Top 10 {STATE} counties: low-income, low-access "
                 "residents per grocery store")
    ax.set_xlabel("Residents per grocery store")
    fig.tight_layout()
    fig.savefig(OUTPUT_DIR / "top10_opportunity_counties.png", dpi=200)
    plt.close(fig)

    fig, ax = plt.subplots(figsize=(8, 5))
    sns.regplot(data=df, x="pct_snap", y="groc_per_10k",
                scatter_kws={"alpha": 0.6}, ax=ax)
    ax.set_title("SNAP participation vs. grocery stores per 10,000")
    ax.set_xlabel("SNAP participation (% of population, latest year)")
    ax.set_ylabel("Grocery stores per 10,000")
    fig.tight_layout()
    fig.savefig(OUTPUT_DIR / "snap_vs_store_density.png", dpi=200)
    plt.close(fig)


def main():
    """Run the full pipeline."""
    OUTPUT_DIR.mkdir(exist_ok=True)
    tables = load_tables(get_engine())
    df = engineer_features(wrangle(tables))
    df = df[df["state"] == STATE]
    diagnostic_plots(df)
    stakeholder_charts(df)
    top10 = df.nlargest(10, "lowi_per_store")
    top10[["county", "population", "laccess_lowi", "groc",
           "lowi_per_store"]].to_csv(OUTPUT_DIR / "top10_table.csv",
                                     index=False)
    print(top10[["county", "lowi_per_store"]])


if __name__ == "__main__":
    main()
